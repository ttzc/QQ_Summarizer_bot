# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# ---- QQ 机器人（QQ 开放平台 → 机器人管理端 → 开发设置）----
QQ_APPID=
QQ_SECRET=

# ---- LLM 网关（任意 OpenAI 兼容端点）----
# 留空 LLM_BASE_URL 即走 OpenAI 官方端点；用别家网关就填它的兼容端点地址。
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# ---- Embedding 网关（可与 LLM 用不同的网关，故单独一组变量）----
EMBED_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=
