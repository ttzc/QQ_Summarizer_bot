# 复制为 `.env` 并填写。
#
# **这里只放敏感凭据。** 模型名、网关地址、各种阈值都在 `config.toml`，
# 本文件里的变量名与 `config.toml` 中的 `${VAR}` 占位符一一对应。
# `.env` 已 gitignore —— 不要把真实值提交进仓库。

# ---- QQ 机器人（QQ 开放平台 → 机器人管理端 → 开发设置）----
# appid 不是密钥，但与 secret 成对下发、成对使用。
QQ_APPID=
QQ_SECRET=

# ---- 两个网关的 API key（模型名与 base_url 在 config.toml 的 [llm]/[embedding]）----
LLM_API_KEY=
EMBED_API_KEY=
